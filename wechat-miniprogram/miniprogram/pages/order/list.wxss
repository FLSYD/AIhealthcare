.order-list__scroll {
  height: calc(100vh - 46px - 88rpx - var(--tabbar-height));
}

.order-list__content {
  padding: 24rpx 32rpx;
}

.order-list__login-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding-top: 48rpx;
}

.order-list__tip {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.order-list__tip--link {
  color: #00B894;
}